# Private licensing tooling — keys/secrets, never commit (also never reaches main)
/licensing/
license_client.py

# Private Full Auto (paid feature) — never commit / never reaches public main.
# full_auto.py was tracked, so it's also untracked via `git rm --cached full_auto.py`
# (the working file stays on disk for the private/paid build). NOTE: its OLD commits
# on the Full-auto branch still contain it, so merge Full-auto -> main with a SQUASH
# merge (git merge --squash) so that history doesn't carry the source over.
full_auto.py
DESIGN_FULL_AUTO.md
PAID_FUNCTION.md
# Full Auto template images (game screens for the paid feature). Untracked via
# `git rm -r --cached templates/*/full_auto`; they stay on disk so the private
# build still bundles them, but they never reach the public main.
templates/**/full_auto/

